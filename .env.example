# --- OpenAI (임베딩 + 답 생성 + 판정 LLM) ---
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_GEN_MODEL=gpt-5.4-mini
OPENAI_JUDGE_MODEL=gpt-5.6-sol

# --- Postgres (pgvector) ---
DATABASE_URL=postgresql+psycopg://cheongyak:cheongyak@localhost:5433/cheongyak

# --- 공공 API ---
# 법제처 국가법령정보 OPEN API 인증값 (lawService.do 의 OC 파라미터)
LAW_OC=
# 공공데이터포털(odcloud/data.go.kr) 서비스 키
DATA_GO_KR_KEY=

# --- trace ---
# 프로필 해시(HMAC-SHA256)용 비밀 키. 임의의 긴 문자열. 비어 있으면 판정 CLI가 흐름 전에 멈춘다
TRACE_HASH_KEY=

# --- 앱 ---
LOG_LEVEL=INFO
